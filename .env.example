# Copie para .env (desenvolvimento) ou .env.production (VPS).

# Postgres. No VPS: postgres://ipvb:SENHA@127.0.0.1:5432/ipvb
# No Netlify (teste), o Netlify DB preenche NETLIFY_DATABASE_URL sozinho; esta pode ficar vazia lá.
# Para rodar no seu computador, use a URL do banco de teste (Neon/Netlify DB).
DATABASE_URL=

# Chave longa e aleatória, diferente em cada ambiente.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=troque-por-uma-chave-longa

# VPS: pasta das fotos, fora do código (sobrevive às atualizações).
MEDIA_DIR=/var/www/ipvb-media

# Netlify: token do Uploadthing (o disco do Netlify não guarda arquivos).
# No VPS, deixe vazio: as fotos ficam em MEDIA_DIR.
UPLOADTHING_TOKEN=

# ID do canal do YouTube (começa com UC...). Usado para listar os sermões.
YOUTUBE_CHANNEL_ID=

# Endereço público do site.
NEXT_PUBLIC_SITE_URL=https://www.ipvb.org.br
