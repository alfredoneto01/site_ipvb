# Banco: arquivo local no desenvolvimento; em produção, a URL libsql:// do Turso.
DATABASE_URL=file:./ipvb.db
# Só em produção (token do banco no Turso).
DATABASE_AUTH_TOKEN=

# Chave longa e aleatória. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=troque-por-uma-chave-longa

# Só em produção: token do app no Uploadthing (fotos). Sem ele, as fotos ficam na pasta /media.
UPLOADTHING_TOKEN=

# ID do canal do YouTube (começa com UC...). Usado para listar os sermões.
YOUTUBE_CHANNEL_ID=

# Endereço público do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
